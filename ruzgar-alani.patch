+
+/* ===================== canlı rüzgâr alanı (kapak göstergesi) ===================== */
+.ralan{position:absolute;z-index:3;top:calc(72px + 4.25rem);right:var(--a-gut);width:17.75rem;padding:.95rem 1.05rem .85rem;
+  background:rgba(8,11,13,.74);border:1px solid rgba(255,255,255,.12);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);
+  font-family:var(--mono);color:#e9edf0;font-variant-numeric:tabular-nums}
+.ralan[hidden]{display:none}
+.ralan::before,.ralan::after{content:"";position:absolute;width:.55rem;height:.55rem;pointer-events:none}
+.ralan::before{left:-1px;top:-1px;border-left:1px solid #c7ff32;border-top:1px solid #c7ff32}
+.ralan::after{right:-1px;bottom:-1px;border-right:1px solid #c7ff32;border-bottom:1px solid #c7ff32}
+.ralan p{margin:0}
+.ralan-ust{display:flex;align-items:center;gap:.55rem;font-size:.625rem;letter-spacing:.2em;text-transform:uppercase;color:#c7ff32}
+.ralan-yer{margin-top:.55rem!important;display:flex;align-items:baseline;justify-content:space-between;gap:.75rem;
+  font-family:var(--sans);font-size:1.375rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:#fff;line-height:1.1}
+.ralan-yer span{font-family:var(--mono);font-size:.625rem;font-weight:400;letter-spacing:.12em;color:#aab3ba}
+.ralan-dl{position:relative;margin:.6rem 0 0;padding-top:.45rem;border-top:1px solid rgba(255,255,255,.16)}
+.ralan-dl::before{content:"";position:absolute;left:0;top:-1px;width:2.25rem;height:1px;background:#c7ff32}
+.ralan-dl > div{display:flex;align-items:baseline;gap:.6rem;padding:.26rem 0}
+.ralan-dl dt{flex:1;display:flex;align-items:center;gap:.55rem;font-size:.625rem;letter-spacing:.16em;text-transform:uppercase;color:#aab3ba}
+.ralan-dl dt::after{content:"";flex:1;height:1px;min-width:.75rem;background:repeating-linear-gradient(90deg,rgba(255,255,255,.2) 0 2px,transparent 2px 5px)}
+.ralan-dl dd{margin:0;display:flex;align-items:baseline;gap:.3rem;white-space:nowrap}
+.ralan-dl dd b{font-size:.9375rem;font-weight:500;color:#fff;letter-spacing:-.01em}
+.ralan-dl dd small{font-size:.625rem;color:#aab3ba;letter-spacing:.04em}
+.ralan-ok{align-self:center;flex:none;color:#c7ff32;transition:transform 1.2s cubic-bezier(.16,1,.3,1)}
+.ralan-egri{margin-top:.7rem;padding-top:.65rem;border-top:1px solid rgba(255,255,255,.12)}
+.ralan-egri > p:first-child{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:.45rem;font-size:.625rem;letter-spacing:.16em;text-transform:uppercase;color:#aab3ba}
+.ralan-egri > p:first-child b{font-weight:500;font-size:.75rem;letter-spacing:.04em;color:#c7ff32}
+.ralan-bar{display:grid;grid-template-columns:repeat(19,minmax(0,1fr));gap:2px;height:.75rem}
+.ralan-bar i{background:rgba(255,255,255,.1);transition:background-color .3s ease}
+.ralan-bar i.y{background:#c7ff32}
+.ralan-olcek{display:flex;justify-content:space-between;margin-top:.3rem!important;font-size:.5625rem;letter-spacing:.08em;color:#aab3ba}
+.ralan-kf{display:flex;justify-content:space-between;align-items:flex-end;gap:.75rem;margin-top:.7rem!important;font-size:.625rem;letter-spacing:.16em;text-transform:uppercase;color:#aab3ba}
+.ralan-kf[hidden]{display:none}
+.ralan-kf small{display:block;margin-top:.2rem;font-size:.5625rem;letter-spacing:.06em;text-transform:none}
+.ralan-kf b{font-family:var(--sans);font-size:1.5rem;font-weight:600;letter-spacing:-.02em;line-height:1;color:#fff}
+.ralan-zaman{display:flex;align-items:center;gap:.45rem;margin-top:.7rem!important;padding-top:.6rem;border-top:1px solid rgba(255,255,255,.12);font-size:.625rem;letter-spacing:.06em;color:#dfe5e9}
+.ralan-nokta{width:.3rem;height:.3rem;border-radius:50%;background:#c7ff32;flex:none}
+.ralan-not{margin-top:.35rem!important;font-size:.5625rem;line-height:1.55;color:#aab3ba}
+.ralan-kisa,.ralan-kf-kisa{display:none}
+.ralan-kf-kisa{text-decoration:none;border:0;cursor:help}
+.ralan-not a{color:#e9edf0;border-bottom:1px solid rgba(255,255,255,.3);white-space:nowrap}
+.ralan-not a:hover,.ralan-not a:focus-visible{color:#c7ff32;border-color:#c7ff32}
+
+/* dar ve alçak ekranlar: gösterge yatay, kapağı kapatmasın */
+@media (max-width:820px),(min-width:821px) and (max-height:780px){
+  .ralan{display:grid;grid-template-columns:minmax(0,1fr) auto;grid-template-areas:"ust yer" "dl dl" "egri egri" "kf zaman" "not not";
+    align-items:center;column-gap:.75rem;top:calc(72px + 1.25rem);left:var(--a-gut);width:auto;max-width:34rem;right:var(--a-gut);padding:.6rem .8rem .55rem}
+  .ralan-ust{grid-area:ust;font-size:.5625rem}
+  .ralan-yer{grid-area:yer;justify-self:end;margin:0!important;font-size:.75rem;letter-spacing:.12em}
+  .ralan-yer span{display:none}
+  .ralan-dl{grid-area:dl;display:grid;grid-template-columns:repeat(5,minmax(0,auto));justify-content:space-between;gap:.25rem .9rem;margin-top:.45rem;padding-top:.4rem}
+  .ralan-dl > div{flex-direction:column;align-items:flex-start;gap:.1rem;padding:0}
+  .ralan-dl dt{font-size:.5625rem;letter-spacing:.12em}
+  .ralan-dl dt::after{display:none}
+  .ralan-dl dd b{font-size:.875rem}
+  .ralan-dl dd small{font-size:.5625rem}
+  .ralan-egri{grid-area:egri;display:grid;grid-template-columns:auto minmax(0,1fr);align-items:center;gap:.6rem;margin-top:.45rem;padding-top:.45rem}
+  .ralan-egri > p:first-child{margin:0;gap:.5rem;font-size:.5625rem;letter-spacing:.12em}
+  .ralan-bar{height:.5rem}
+  .ralan-olcek{display:none!important}
+  .ralan-kf{grid-area:kf;justify-content:flex-start;align-items:baseline;margin-top:.4rem!important;font-size:.5625rem;letter-spacing:.12em}
+  .ralan-kf small{display:inline;margin:0 0 0 .35rem}
+  .ralan-kf b{order:2;font-family:var(--mono);font-size:.75rem;font-weight:500;letter-spacing:.02em}
+  .ralan-zaman{grid-area:zaman;margin-top:.4rem!important;padding:0;border:0;font-size:.5625rem;justify-self:end}
+  .ralan-not{grid-area:not;margin-top:.3rem!important}
+}
+@media (max-width:560px){
+  .ralan{top:calc(64px + .5rem);padding:.5rem .7rem .45rem;grid-template-columns:auto minmax(0,1fr) auto;grid-template-areas:"ust yer zaman" "dl dl dl" "egri egri kf" "not not not";column-gap:.6rem}
+  .ralan-yer{justify-self:start;font-size:.6875rem}
+  .ralan-zaman{margin:0!important}
+  .ralan-g{display:none}
+  .ralan-dl{gap:.2rem .5rem}
+  .ralan-dl dt{font-size:.5rem;letter-spacing:.08em}
+  .ralan-dl dd{flex-wrap:wrap;column-gap:.25rem;row-gap:0}
+  .ralan-dl dd small{flex-basis:100%}
+  .ralan-dl dd b{font-size:.8125rem}
+  .ralan-dl{margin-top:.35rem;padding-top:.35rem}
+  .ralan-egri{margin-top:.35rem;padding-top:.35rem}
+  .ralan-kf{margin:.35rem 0 0!important;gap:.4rem;padding-top:.35rem;border-top:1px solid rgba(255,255,255,.12);align-self:stretch}
+  .ralan-kf-ad{display:none}
+  .ralan-kf-kisa{display:inline}
+  .ralan-uzun{display:none}
+  .ralan-kisa{display:inline}
+}
+@media (prefers-reduced-motion:reduce){ .ralan-bar i,.ralan-ok{transition:none} }
