+  body.ana-body header, :root body.ana-body header, :root[data-vardiya] body.ana-body header { background: rgba(9, 12, 14, .92) !important; }
+  .dny-dg a, .dny-dg button, .v-ust { background: rgba(7, 9, 11, .82) !important; }
+  .ralan { background: rgba(8, 11, 13, .9) !important; }
+}
