+.ana .kule-alt{position:absolute;left:0;right:0;bottom:0;padding:0 var(--a-gut) clamp(1.5rem,4vh,2.75rem);max-width:var(--a-max);margin:0 auto;display:grid}
+.ana .durak{grid-area:1/1;align-self:end;opacity:0;transform:translateY(12px);transition:opacity .45s ease,transform .45s ease;pointer-events:none}
+.ana .durak.etkin{opacity:1;transform:none;pointer-events:auto}
