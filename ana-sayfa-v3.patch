+body.ana-body header .plate:hover{background:#d8ff6a}
+
+.ana .kule{position:relative;border-top:0;padding:0;height:min(86svh,54rem);background:#0b0e10}
+.ana .kule.uc-boyut{height:380vh}
+.ana .kule-sahne{position:sticky;top:0;height:100svh;max-height:100vh;overflow:hidden;isolation:isolate;
+  background:#0b0e10 url(/assets/saha/ege-levha.webp) center/cover no-repeat}
+.ana .kule.statik .kule-sahne{position:relative;height:100%}
+.ana .kule-sahne canvas{position:absolute;inset:0;width:100%;height:100%;display:block;z-index:-2;opacity:0;transition:opacity 1.2s ease}
+.ana .kule-sahne canvas.hazir{opacity:1}
+.ana .kule-sahne::after{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;
+  background:linear-gradient(180deg,rgba(11,14,16,.55) 0,rgba(11,14,16,0) 26%,rgba(11,14,16,0) 52%,rgba(11,14,16,.72) 84%,#0b0e10 100%)}
+
+/* canlı gösterge */
+.ana .hud{position:absolute;top:calc(72px + 1.25rem);left:var(--a-gut);width:min(19rem,calc(100% - 2*var(--a-gut)));
+  padding:.9rem 1rem .8rem;background:rgba(11,14,16,.62);border:1px solid rgba(255,255,255,.12);backdrop-filter:blur(10px);
+  font-family:var(--mono);color:#e9edf0}
+.ana .hud[hidden]{display:none}
+.ana .hud-ust{margin:0;display:flex;align-items:center;gap:.5rem;font-size:.6875rem;letter-spacing:.14em;text-transform:uppercase;color:#c7ff32}
+.ana .nabiz{width:.45rem;height:.45rem;border-radius:50%;background:#c7ff32;box-shadow:0 0 0 0 rgba(199,255,50,.6);animation:nabiz 2s infinite}
+@keyframes nabiz{70%{box-shadow:0 0 0 .5rem rgba(199,255,50,0)}100%{box-shadow:0 0 0 0 rgba(199,255,50,0)}}
+.ana .hud dl{margin:.75rem 0 0;display:grid;grid-template-columns:1fr 1fr;gap:.6rem 1rem}
+.ana .hud dt{font-size:.625rem;letter-spacing:.14em;text-transform:uppercase;color:#aab3ba}
+.ana .hud dd{margin:.15rem 0 0;font-size:.8125rem;color:#e9edf0;font-variant-numeric:tabular-nums}
+.ana .hud dd b{font-family:var(--sans);font-size:1.35rem;font-weight:600;letter-spacing:-.02em;margin-right:.15rem}
+.ana .hud-alt{margin:.7rem 0 0;font-size:.625rem;line-height:1.5;color:#aab3ba}
+.ana .hud-alt a{color:#e9edf0;border-bottom:1px solid rgba(255,255,255,.3)}
+
+/* kot göstergesi (kameranın gerçek yüksekliği) */
+.ana .kot{position:absolute;right:var(--a-gut);top:calc(72px + 2rem);bottom:clamp(12rem,30vh,16rem);width:4.5rem;
+  display:flex;flex-direction:column;align-items:flex-end;gap:.6rem;font-family:var(--mono);color:#e9edf0;pointer-events:none}
+.ana .kule.statik .kot{display:none}
+.ana .kot-deger{font-size:.6875rem;letter-spacing:.12em;text-transform:uppercase;color:#aab3ba}
+.ana .kot-deger b{font-family:var(--sans);font-size:1.6rem;font-weight:600;letter-spacing:-.03em;color:#fff;font-variant-numeric:tabular-nums}
+.ana .kot-cetvel{position:relative;flex:1;width:100%;border-right:1px solid rgba(255,255,255,.35)}
