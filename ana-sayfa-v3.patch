+/* ===================== v3: kuleye tırmanış kapağı ===================== */
+/* üst menü: ana sayfada koyu (aynı bileşenler, koyu değişkenlerle) */
+body.ana-body header{--ink:#e9edf0;--muted:#aab3ba;--line:#262e35;--surface:#141a1f;--raise:#1b2328;--ground:#0b0e10;
+  background:rgba(11,14,16,.82);border-bottom-color:#1d252b;backdrop-filter:blur(12px)}
