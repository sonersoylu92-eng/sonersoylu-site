+.ana .kule.statik .kaydir{display:none}
+.ana .kule .rakam{margin-top:clamp(1.5rem,4vh,2.5rem)}
+
+/* ===================== kısaca ===================== */
+.ana .giris-izgara{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,1fr);gap:clamp(2rem,6vw,5rem);align-items:end}
+.ana .soz{margin:1.25rem 0 0;font-family:var(--serif);font-style:italic;font-weight:400;font-size:clamp(1.6rem,3.3vw,2.7rem);line-height:1.22;letter-spacing:-.02em;color:#f2f4f5;text-wrap:pretty;position:relative;padding-left:clamp(1.25rem,3vw,2rem);border-left:2px solid #c7ff32}
+.ana .giris-yan .giris{margin-top:0}
+.ana .platform{list-style:none;margin:1.75rem 0 0;padding:0;border-top:1px solid var(--a-line)}
+.ana .platform li{display:flex;justify-content:space-between;gap:1rem;padding:.8rem 0;border-bottom:1px solid var(--a-line)}
+.ana .platform b{font-weight:600;color:var(--a-ink)}
+.ana .platform span{font-family:var(--mono);font-size:.8125rem;color:var(--a-muted);text-align:right}
+
+/* ===================== saha geçmişi ===================== */
+.ana .zaman{list-style:none;margin:3rem 0 0;padding:0;position:relative}
+.ana .zaman::before{content:"";position:absolute;left:4.25rem;top:.4rem;bottom:.4rem;width:1px;background:var(--a-line)}
+.ana .zaman li{display:grid;grid-template-columns:4.25rem minmax(0,1fr);gap:0 2rem;padding:0 0 2rem;position:relative}
+.ana .zaman li::before{content:"";position:absolute;left:calc(4.25rem - .3rem);top:.45rem;width:.6rem;height:.6rem;border-radius:50%;background:#0b0e10;border:1px solid var(--a-faint)}
+.ana .zaman li:first-child::before{background:#c7ff32;border-color:#c7ff32;box-shadow:0 0 12px rgba(199,255,50,.6)}
+.ana .zaman .yil{font-family:var(--mono);font-size:.8125rem;color:var(--a-accent);padding-top:.1rem}
+.ana .zaman h3{margin:0;font-size:1.1875rem;font-weight:600;letter-spacing:-.02em;color:var(--a-ink)}
+.ana .zaman .rol{margin:.3rem 0 0;font-size:.875rem;color:var(--a-muted)}
+.ana .zaman .rol span{color:var(--a-faint)}
+.ana .zaman .oz{margin:.55rem 0 0;max-width:72ch;font-size:.9375rem;line-height:1.6;color:var(--a-muted)}
+
+/* ===================== video ===================== */
+.ana .an-video{display:grid;grid-template-columns:auto minmax(0,1fr);gap:clamp(1.5rem,4vw,3rem);align-items:center;margin-top:3rem;padding-top:3rem;border-top:1px solid var(--a-line)}
+.ana .an-video-kutu{width:min(18rem,70vw);aspect-ratio:9/16;max-width:100%;background:#000;border:1px solid var(--a-line)}
+.ana .an-video-kutu iframe{width:100%;height:100%;border:0;display:block}
+.ana .an-video-b{margin:.75rem 0 1.5rem;font-size:clamp(1.4rem,2.6vw,2rem);font-weight:600;letter-spacing:-.03em;line-height:1.15;color:var(--a-ink);max-width:18ch}
+
+/* ===================== yazılar ===================== */
+.ana .yazilar{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,15.5rem),1fr));gap:1rem;margin-top:3rem}
+.ana .yazi{display:flex;flex-direction:column;gap:.6rem;padding:1.4rem;border:1px solid var(--a-line);background:var(--a-surface);transition:border-color .2s,transform .3s cubic-bezier(.16,1,.3,1)}
+.ana .yazi:hover{border-color:var(--a-accent);transform:translateY(-2px)}
+.ana .yazi .k-ust{font-family:var(--mono);font-size:.6875rem;letter-spacing:.14em;text-transform:uppercase;color:var(--a-faint)}
+.ana .yazi b{font-size:1.125rem;line-height:1.3;font-weight:600;letter-spacing:-.02em;color:var(--a-ink);text-wrap:balance}
+.ana .yazi .a{font-size:.9rem;line-height:1.55;color:var(--a-muted)}
+.ana .yazi .git{margin-top:auto;padding-top:.4rem;font-family:var(--mono);font-size:.75rem;letter-spacing:.1em;text-transform:uppercase;color:var(--a-accent)}
+.ana .yazi .git::after{content:" ↗"}
+
+/* ===================== yetkinlik ===================== */
+.ana .yetki{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(1.5rem,4vw,3rem);margin-top:3rem}
+.ana .yetki h3{margin:0 0 .75rem;font-family:var(--mono);font-size:.75rem;font-weight:500;letter-spacing:.16em;text-transform:uppercase;color:var(--a-faint)}
+.ana .yetki .ara-bas{margin-top:2rem}
+.ana .yetki ul{list-style:none;margin:0;padding:0;border-top:1px solid var(--a-line)}
+.ana .yetki li{padding:.7rem 0;border-bottom:1px solid var(--a-line);font-size:.9375rem;color:var(--a-ink)}
+.ana .yetki li b{display:block;font-weight:600}
+.ana .yetki li span{display:block;margin-top:.2rem;font-size:.8125rem;color:var(--a-muted)}
+
+@media (max-width:860px){
+  .ana .giris-izgara{grid-template-columns:1fr}
+  .ana .an-video{grid-template-columns:1fr}
+  .ana .yetki{grid-template-columns:1fr}
+  .ana .kule.uc-boyut{height:320vh}
+  .ana .kot{width:3.5rem;bottom:auto;top:auto;height:11rem;top:calc(72px + 13.5rem)}
+}
+@media (max-width:560px){
+  .ana .zaman::before{left:3.2rem}
+  .ana .zaman li{grid-template-columns:3.2rem minmax(0,1fr);gap:0 1.25rem}
+  .ana .zaman li::before{left:calc(3.2rem - .3rem)}
+  .ana .hud{top:calc(64px + .75rem)}
+  .ana .hud dd b{font-size:1.15rem}
+  .ana .kot{display:none}
+}
+@media (prefers-reduced-motion:reduce){ .ana .nabiz,.ana .kaydir::before{animation:none} }
+main.ana{padding-top:0}
+
+@media (min-width:861px){.ana .kartlar.uclu{grid-template-columns:repeat(3,minmax(0,1fr))}}
+.ana .an-video{background:transparent}
+@media (max-width:560px){
+  .ana .hud{padding:.6rem .75rem .55rem}
+  .ana .hud dl{grid-template-columns:repeat(4,auto);gap:.2rem .9rem;margin-top:.45rem}
+  .ana .hud dt{font-size:.5625rem}
+  .ana .hud dd{font-size:.6875rem}
+  .ana .hud dd b{font-size:1rem}
+  .ana .hud-alt{margin-top:.4rem;font-size:.5625rem}
+}
