+
+/* ===================== 6. galeri ===================== */
+.ana .gal{counter-reset:g;grid-auto-rows:clamp(8.5rem,15vw,13rem);gap:.6rem}
+.ana .gal figure{counter-increment:g;isolation:isolate}
+.ana .gal img{transition:transform .9s var(--v-ease),filter .5s}
+.ana .gal figure:hover img,.ana .gal figure:focus-within img{transform:scale(1.03)}
+.ana .gal figure::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(7,9,11,0) 45%,rgba(7,9,11,.75));opacity:.55;transition:opacity .4s;pointer-events:none}
+.ana .gal figure:hover::after,.ana .gal figure:focus-within::after{opacity:1}
+.ana .gal figcaption{z-index:1;background:none;padding:1rem;display:flex;flex-direction:column;gap:.35rem}
+.ana .gal figcaption::before{content:counter(g,decimal-leading-zero) " / 08";font-size:.5625rem;letter-spacing:.2em;color:#c7ff32}
+.ana .gal figcaption::after{content:attr(data-aciklama);font-family:var(--sans);font-size:.8125rem;line-height:1.45;letter-spacing:0;text-transform:none;color:#d6dce0;
+  max-height:0;opacity:0;overflow:hidden;transition:max-height .45s var(--v-ease),opacity .35s}
+.ana .gal figure:hover figcaption::after,.ana .gal figure:focus-within figcaption::after{max-height:5rem;opacity:1}
+@media (min-width:861px){
+  .ana .gal .g1{grid-column:span 7;grid-row:span 3}
+  .ana .gal .g2{grid-column:span 5;grid-row:span 2}
+  .ana .gal .g3{grid-column:span 5}
+  .ana .gal .g4{grid-column:span 4;grid-row:span 2}
+  .ana .gal .g5{grid-column:span 3;grid-row:span 2}
+  .ana .gal .g6{grid-column:span 5;grid-row:span 2}
+  .ana .gal .g7{grid-column:span 7}
+  .ana .gal .g8{grid-column:span 5}
+}
+@media (hover:none){ .ana .gal figcaption::after{max-height:5rem;opacity:.9} .ana .gal figure::after{opacity:.9} }
+
+/* ===================== 7. kariyer çizgisi ===================== */
+.v-zaman{position:relative;margin-top:3rem}
+.v-z-hat{position:absolute;left:8.5rem;top:.5rem;bottom:.5rem;width:1px;background:var(--a-line)}
+.v-z-hat i{position:absolute;inset:0 0 auto 0;height:100%;background:linear-gradient(#c7ff32,#6fdcec);transform-origin:top;transform:scaleY(var(--z,0))}
+.ana .zaman.v-z{margin:0}
+.ana .zaman.v-z::before{display:none}
+.ana .zaman.v-z li{grid-template-columns:8.5rem minmax(0,1fr);gap:0 2.5rem;padding:0 0 2.25rem}
+.ana .zaman.v-z li::before{left:calc(8.5rem - .3rem);top:.55rem;background:#0b0e10;border-color:#4a535a;box-shadow:none;transition:background .4s,border-color .4s,box-shadow .4s}
+.ana .zaman.v-z li.ulasti::before{background:#c7ff32;border-color:#c7ff32}
+.ana .zaman.v-z li.v-z-simdi::before{box-shadow:0 0 0 4px rgba(199,255,50,.15),0 0 14px rgba(199,255,50,.6)}
+.v-z-yil{display:flex;flex-direction:column;gap:.35rem;padding-right:1rem}
+.v-z-yil b{font-family:var(--mono);font-size:1.5rem;font-weight:500;letter-spacing:-.02em;color:#fff;line-height:1;font-variant-numeric:tabular-nums}
+.v-z-yil span{font-family:var(--mono);font-size:.625rem;letter-spacing:.06em;color:#8f989f;line-height:1.4}
+.v-z-simdi .v-z-yil b{color:#c7ff32}
+.v-z-kart h3{margin:0;font-size:1.25rem;font-weight:600;letter-spacing:-.02em;color:var(--a-ink)}
+.ana .v-z-kart .rol{margin:.25rem 0 0;font-size:.9375rem;color:#c9d0d5}
+.v-z-dl{margin:.9rem 0 0;display:grid;gap:.45rem;padding-top:.8rem;border-top:1px solid var(--a-line);max-width:72ch}
+.v-z-dl div{display:grid;grid-template-columns:7.5rem minmax(0,1fr);gap:1rem}
+.v-z-dl dt{font-family:var(--mono);font-size:.5625rem;letter-spacing:.2em;text-transform:uppercase;color:#8f989f;padding-top:.2rem}
+.v-z-dl dd{margin:0;font-size:.9rem;line-height:1.55;color:var(--a-muted)}
+.v-z-dl div:first-child dd{font-family:var(--mono);font-size:.8125rem;color:#6fdcec}
+
+/* ===================== 11. son sahne ===================== */
+body.ana-body footer.v-son{position:relative;overflow:hidden;border-top:1px solid #1b2127;background:#050708;color:#9aa3ab;isolation:isolate}
+footer.v-son::before{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;
+  background-image:linear-gradient(rgba(233,237,240,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(233,237,240,.035) 1px,transparent 1px);background-size:72px 72px;
+  -webkit-mask-image:linear-gradient(180deg,transparent,#000 40%);mask-image:linear-gradient(180deg,transparent,#000 40%)}
+.v-son-ic{max-width:76rem;margin:0 auto;padding:clamp(4rem,10vw,7.5rem) clamp(1rem,4vw,2rem) 2rem}
+.v-son-ust{margin:0;display:flex;flex-wrap:wrap;gap:.4rem 1.5rem;font-family:var(--mono);font-size:.625rem;letter-spacing:.2em;text-transform:uppercase;color:#8f989f}
+.v-son-ad{margin:1.25rem 0 0;font-family:var(--sans);font-weight:600;font-size:clamp(3.2rem,13vw,11.5rem);line-height:.82;letter-spacing:-.065em;text-transform:uppercase;
+  background:linear-gradient(180deg,#e9edf0 30%,#5d666d 120%);-webkit-background-clip:text;background-clip:text;color:transparent}
+.v-son-alan{margin:1.25rem 0 0;font-family:var(--mono);font-size:clamp(.75rem,1.4vw,.9375rem);letter-spacing:.32em;text-transform:uppercase;color:#e9edf0}
+.v-son-yer{margin:.5rem 0 0;font-family:var(--mono);font-size:.6875rem;letter-spacing:.2em;text-transform:uppercase;color:#8f989f}
+.v-son-imza{margin:clamp(2.5rem,6vw,4.5rem) 0 0;font-size:clamp(1.9rem,5vw,3.75rem);font-weight:600;letter-spacing:-.05em;line-height:1;color:#e9edf0}
+.v-son-imza em{font-style:normal;color:#c7ff32}
+.v-son-alt{margin-top:clamp(2.5rem,6vw,4rem);padding-top:1.25rem;border-top:1px solid #1b2127;display:flex;flex-wrap:wrap;justify-content:space-between;gap:1rem 2rem}
+.v-son-alt p{margin:0;display:flex;flex-wrap:wrap;gap:.5rem 1.5rem}
+.v-son-alt a{font-family:var(--mono);font-size:.6875rem;letter-spacing:.16em;text-transform:uppercase;color:#9aa3ab;padding:.35rem 0;border-bottom:1px solid transparent;transition:color .2s,border-color .2s}
+.v-son-sosyal a{color:#e9edf0}
+.v-son-alt a:hover{color:#c7ff32;border-color:rgba(199,255,50,.5)}
+
+/* ===================== 8. üst menü: sahnede şeffaf ===================== */
+:root body.ana-body.v-sahnede header,:root[data-vardiya] body.ana-body.v-sahnede header{
+  background:linear-gradient(180deg,rgba(7,9,11,.62),rgba(7,9,11,0));border-bottom-color:transparent;backdrop-filter:none;-webkit-backdrop-filter:none}
+body.ana-body header{transition:background .4s ease,border-color .4s ease}
+
+/* ===================== 13. mobil yeniden kurgu ===================== */
+@media (max-width:860px){
+  .v-vk-bas button{grid-template-columns:4.25rem minmax(0,1fr) 1.25rem;gap:.35rem 1rem;padding:1.15rem 0}
+  .v-vk-deger{grid-column:2;flex-direction:row;align-items:baseline;gap:.6rem;flex-wrap:wrap}
+  .v-vk-mdl{grid-column:2;grid-row:3;text-align:left}
+  .v-vk-arti{grid-column:3;grid-row:1}
+  .v-vk-panel{padding:0 0 1.5rem 0}
+  .v-akis li{grid-template-columns:1fr;padding-left:1.5rem}
+  .v-z-hat{left:.3rem}
+  .ana .zaman.v-z li{grid-template-columns:1fr;gap:.6rem;padding:0 0 2rem 1.75rem}
+  .ana .zaman.v-z li::before{left:0}
+  .v-z-yil{flex-direction:row;align-items:baseline;gap:.8rem}
+  .v-z-dl div{grid-template-columns:1fr;gap:.15rem}
+  .ana .rakam.v-olcu > div{padding-right:.75rem}
+  .ana .rakam.v-olcu dd.v-alt{letter-spacing:.04em}
+}
+@media (max-width:560px){
+  .v-koord{display:none}
+  .ana .rakam.v-olcu dd.v-alt{display:none}
+  .ana .v-ad{margin-top:.6rem}
+  .v-ad-unvan{letter-spacing:.18em;align-items:flex-start;line-height:1.5}
+  .v-ad-unvan::before{margin-top:.55em;width:1.25rem}
+  .ana .rakam.v-olcu{grid-template-columns:repeat(2,minmax(0,1fr))}
+  .ana .rakam.v-olcu > div:nth-child(n+3){margin-top:.9rem;border-top:0}
+  .ana .rakam.v-olcu dd{font-size:2rem}
+  .v-cizim{margin:-1.75rem -1.5rem .25rem}
+}
+/* alçak masaüstü ekranlar: kimlik küçülür, düğmelerle çakışmaz */
+@media (min-width:861px) and (max-height:780px){
+  .v-ad-isim{font-size:clamp(2.8rem,6.2vw,5.2rem)}
+  .v-kimlik{margin-bottom:1rem}
+  .ana .rakam.v-olcu dd{font-size:clamp(1.6rem,3vw,2.2rem)}
+  .ana .rakam.v-olcu dd.v-alt{display:none}
+}
+@media (prefers-reduced-motion:reduce){
+  .v-izgara,.v-isik{transform:none!important}
+  .ana .v-parca:hover,.ana .dg:hover,.ana .kartlar a:hover,.ana .yazi:hover{transform:none}
+}
