+.v-cizim .o{fill:none;stroke:rgba(111,220,236,.5);stroke-width:1;stroke-dasharray:3 3;vector-effect:non-scaling-stroke}
+.v-cizim .m{fill:rgba(111,220,236,.8);stroke:rgba(111,220,236,.8);stroke-width:1;vector-effect:non-scaling-stroke}
