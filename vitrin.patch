+.v-izgara{position:absolute;inset:-4%;z-index:-3;pointer-events:none;
+  background-image:linear-gradient(var(--v-grid) 1px,transparent 1px),linear-gradient(90deg,var(--v-grid) 1px,transparent 1px);
+  background-size:72px 72px;
+  -webkit-mask-image:radial-gradient(120% 90% at 30% 85%,#000 0,rgba(0,0,0,.55) 45%,transparent 78%);
+  mask-image:radial-gradient(120% 90% at 30% 85%,#000 0,rgba(0,0,0,.55) 45%,transparent 78%);
+  transform:translate3d(calc(var(--v-mx,0)*-10px),calc(var(--v-my,0)*-8px),0);transition:opacity .8s ease,transform .6s var(--v-ease)}
+.v-isik{position:absolute;inset:0;z-index:-3;pointer-events:none;mix-blend-mode:screen;opacity:.55;
+  background:radial-gradient(60% 45% at 78% 12%,rgba(255,226,190,.16),transparent 70%),radial-gradient(40% 30% at 20% 100%,rgba(111,220,236,.05),transparent 70%);
+  transform:translate3d(calc(var(--v-mx,0)*6px),calc(var(--v-my,0)*4px),0);transition:opacity .8s ease,transform .8s var(--v-ease)}
+.dny-bolum.gecti .v-izgara,.dny-bolum.gecti .v-isik{opacity:0}
+.dny-bolum.gecti canvas.v-ruzgar{opacity:0}
+
+/* kimlik: isim ve unvan */
+.v-kimlik{margin-bottom:clamp(1.25rem,3.2vh,2rem)}
+.v-koord{margin:0;display:flex;flex-wrap:wrap;gap:.35rem 1.25rem;font-family:var(--mono);font-size:.6875rem;letter-spacing:.2em;text-transform:uppercase;color:#e3e8eb;text-shadow:0 1px 10px rgba(0,0,0,.55)}
+.v-koord span{display:inline-flex;align-items:center;gap:.5rem}
+.v-koord span+span::before{content:"";width:.9rem;height:1px;background:rgba(233,237,240,.5)}
+.ana .v-ad{margin:.9rem 0 0;display:flex;flex-direction:column;gap:clamp(.7rem,1.6vh,1rem);font-family:var(--sans);font-weight:600;color:#fff}
+.v-ad-isim{display:block;font-size:clamp(3.1rem,8.2vw,7.4rem);line-height:.9;letter-spacing:-.058em;
+  background:linear-gradient(180deg,#fff 40%,#c9d0d5 100%);-webkit-background-clip:text;background-clip:text;color:transparent;text-wrap:balance}
+.v-ad-unvan{display:flex;align-items:center;gap:.9rem;font-family:var(--mono);font-weight:400;font-size:clamp(.6875rem,1.05vw,.8125rem);letter-spacing:.26em;text-transform:uppercase;color:#dfe5e9}
