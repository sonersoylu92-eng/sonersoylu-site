+.v-vk-ad{font-size:1.1875rem;font-weight:600;letter-spacing:-.02em;color:var(--a-ink)}
+.v-vk-deger{display:flex;flex-direction:column;gap:.2rem}
+.v-vk-deger b{font-family:var(--mono);font-size:1rem;font-weight:500;color:#fff;letter-spacing:-.01em;font-variant-numeric:tabular-nums}
+.v-vk-deger small{font-family:var(--mono);font-size:.625rem;letter-spacing:.08em;color:#8f989f}
+.v-vk-mdl{font-family:var(--mono);font-size:.75rem;color:var(--a-faint);white-space:nowrap;text-align:right}
+.v-vk-arti{position:relative;width:1rem;height:1rem;justify-self:end}
+.v-vk-arti::before,.v-vk-arti::after{content:"";position:absolute;left:0;right:0;top:50%;height:1px;background:#e9edf0;transition:transform .3s var(--v-ease)}
