diff --git a/ana.css b/ana.css
index bee4576..26a7d1c 100644
--- a/ana.css
+++ b/ana.css
@@ -272,3 +272,37 @@ main.ana{padding-top:0}
   .ana .hud dd b{font-size:1rem}
   .ana .hud-alt{margin-top:.4rem;font-size:.5625rem}
 }
+
+/* ===================== v4: pusula ve 24 saatlik eğri ===================== */
+.ana .hud dd{display:flex;align-items:baseline;gap:.3rem}
+.ana .pusula{width:14px;height:14px;flex:none;color:#c7ff32;align-self:center;transition:transform 1.2s cubic-bezier(.16,1,.3,1)}
+.ana .egri{margin-top:.8rem;padding-top:.7rem;border-top:1px solid rgba(255,255,255,.12)}
+.ana .egri[hidden]{display:none}
+.ana .egri-b{margin:0 0 .4rem;display:flex;justify-content:space-between;gap:.5rem;font-size:.625rem;letter-spacing:.12em;text-transform:uppercase;color:#aab3ba}
+.ana .egri-b span:last-child{color:#e9edf0;letter-spacing:.04em;text-transform:none}
+.ana .egri svg{display:block;width:100%;height:2.75rem}
+.ana .egri .alan{fill:rgba(199,255,50,.14)}
+.ana .egri .cizgi{fill:none;stroke:#c7ff32;stroke-width:1.5;vector-effect:non-scaling-stroke}
+.ana .egri circle{fill:#fff}
+@media (max-width:560px){ .ana .egri{display:none} }
+
+/* ===================== v4: ışık kutusu, kopyala, belirme, hız ===================== */
+body.ana-body #lb{flex-direction:column;gap:1rem}
+body.ana-body #lb img{max-height:80vh;cursor:pointer}
+body.ana-body #lb .lb-ok{position:absolute;top:50%;transform:translateY(-50%);width:3rem;height:3rem;border:1px solid rgba(255,255,255,.25);background:rgba(11,14,16,.6);color:#fff;font-size:1.25rem;cursor:pointer}
+body.ana-body #lb .lb-ok:hover{border-color:#c7ff32;color:#c7ff32}
+body.ana-body #lbOnce{left:1rem}
+body.ana-body #lbSonra{right:1rem}
+body.ana-body #lb .lb-alt{margin:0;font-family:var(--mono);font-size:.75rem;letter-spacing:.14em;text-transform:uppercase;color:#aab3ba}
+body.ana-body #lbx{background:#12171b;color:#e9edf0;border-color:#2a3238}
+.ana .kanal .kopya{align-self:flex-start;margin-top:.35rem;min-height:2.25rem;padding:.35rem .8rem;border:1px solid var(--a-line);background:transparent;color:var(--a-accent);font-family:var(--mono);font-size:.6875rem;letter-spacing:.14em;text-transform:uppercase;cursor:pointer}
+.ana .kanal .kopya:hover{border-color:var(--a-accent)}
+/* içerik her zaman görünür; destekleyen tarayıcıda kaydırınca hafifçe yükselir */
+@supports (animation-timeline: view()) {
+  @media (prefers-reduced-motion:no-preference){
+    .ana .parca article,.ana .zaman li,.ana .yazi,.ana .kartlar a,.ana .vaka li,.ana .gal figure,.ana .soz{animation:yuksel linear both;animation-timeline:view();animation-range:entry 0% entry 55%}
+    @keyframes yuksel{from{opacity:.25;transform:translateY(24px)}to{opacity:1;transform:none}}
+  }
+}
+/* ekran dışı bölümler çizilmeden bekler: ilk açılış daha hızlı */
+.ana section:not(.kule){content-visibility:auto;contain-intrinsic-size:auto 900px}
diff --git a/assets/kule3d.js b/assets/kule3d.js
index 082c8e0..987d884 100644
--- a/assets/kule3d.js
+++ b/assets/kule3d.js
@@ -72,6 +72,23 @@ export function kuleBaslat(canvas, bolum, geri) {
   function isik() { const m = isikModu(); if (m !== sonMod) { setLight(m); sonMod = m; } }
   isik();
 
+  // Nasel gerçek rüzgâra döner: --yon-derece (meteorolojik, rüzgârın geldiği yön).
+  // Sahnede -z kuzey kabul ediliyor; rotor -z'ye bakıyor, yani 0° kuzey rüzgârında yüzü kuzeye.
+  function yonHedef() {
+    const d = parseFloat(getComputedStyle(kok).getPropertyValue('--yon-derece'));
+    return isFinite(d) ? -d * Math.PI / 180 : null;
+  }
+  let yawIlk = true;
+  function yawGuncelle(dt) {
+    const h = yonHedef();
+    if (h === null || !parts.yaw) return;
+    if (yawIlk) { parts.yaw.rotation.y = h; yawIlk = false; return; }
+    let fark = h - parts.yaw.rotation.y;
+    fark = Math.atan2(Math.sin(fark), Math.cos(fark));
+    const adim = 0.35 * Math.PI / 180 * dt * 60;          // gerçek yaw gibi yavaş
+    parts.yaw.rotation.y += Math.max(-adim, Math.min(adim, fark));
+  }
+
   function devirRad() {
     const s = parseFloat(getComputedStyle(kok).getPropertyValue('--devir-sure'));
     return s > 0 ? (2 * Math.PI) / s : 0;
@@ -122,6 +139,7 @@ export function kuleBaslat(canvas, bolum, geri) {
     camera.lookAt(hedef);
 
     if (parts.spin) parts.spin.rotation.z -= devirRad() * dt;
+    yawGuncelle(dt);
     isikGrubu.visible = (t % 2000) < 1000;
     if (parts.farm) parts.farm.children.forEach(f => { const r = f.getObjectByName && f.getObjectByName('rotor'); if (r) r.rotation.z -= (f.userData.speed || 0.2) * dt; });
 
