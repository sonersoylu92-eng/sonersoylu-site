+.tsh-kart:hover{background:var(--raise)}
+.tsh-kart[aria-pressed="true"]{background:var(--raise);box-shadow:inset 0 2px 0 var(--beacon)}
+.tsh-kart .n{display:flex;justify-content:space-between;font-family:var(--mono);font-size:.625rem;letter-spacing:.16em;text-transform:uppercase;color:var(--beacon)}
+.tsh-kart .n span{color:var(--muted)}
+.tsh-kart .a{font-size:1.25rem;font-weight:600;letter-spacing:-.02em}
+.tsh-kart .l{font-family:var(--mono);font-size:.75rem;line-height:1.5;color:var(--uyari)}
+.tsh-kart .g{margin-top:auto;padding-top:.6rem;font-family:var(--mono);font-size:.6875rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
