-   <tr><td>Rotor speed</td><td>6–18 rpm</td><td><strong>5–16 rpm (slower)</strong></td></tr>
-   <tr><td>Drivetrain</td><td>Direct-drive</td><td><strong>Direct-drive (same)</strong></td></tr>
-   <tr><td>Hub height</td><td>78 / 85 / 98 / 108 / 138 m</td><td><strong>84 / 98 / 104 / 138 m</strong></td></tr>
-   <tr><td>Target wind class</td><td>IEC IIA</td><td><strong>IEC IIA / IIIA (low–medium)</strong></td></tr>
-   <tr><td>Power per swept area</td><td>~568 W/m²</td><td><strong>~353 W/m² (low-wind signature)</strong></td></tr>
