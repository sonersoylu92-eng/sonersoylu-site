-   <tr><td>Rotor Devri</td><td>6–18 rpm</td><td><strong>5–16 rpm (daha yavaş)</strong></td></tr>
-   <tr><td>Aktarma Organı</td><td>Direct-drive</td><td><strong>Direct-drive (aynı)</strong></td></tr>
-   <tr><td>Göbek Yüksekliği</td><td>78 / 85 / 98 / 108 / 138 m</td><td><strong>84 / 98 / 104 / 138 m</strong></td></tr>
