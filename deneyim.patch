diff --git a/assets/deneyim/deneyim.css b/assets/deneyim/deneyim.css
new file mode 100644
index 0000000..d8ce55f
--- /dev/null
+++ b/assets/deneyim/deneyim.css
@@ -0,0 +1,140 @@
+/* deneyim.css — /deneyim/ sayfası: türbinin içine sinematik yolculuk.
+ * Palet: grafit, çelik, mat siyah, soğuk beyaz, ince camgöbeği. Sitenin limon
+ * vurgusu yalnız marka ve eylem düğmelerinde. */
+.dny{--d-bg:#07090b;--d-ink:#eef2f5;--d-muted:#a3adb5;--d-faint:#76818a;--d-line:rgba(238,242,245,.14);
+  --d-cyan:#6fdcec;--d-accent:#c7ff32;--d-gut:clamp(1rem,4vw,2.25rem);
+  background:var(--d-bg);color:var(--d-ink);color-scheme:dark}
+.dny .gizli{position:absolute!important;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
+.dny :focus-visible{outline:2px solid var(--d-cyan);outline-offset:3px}
+
+/* ---- sahne ---- */
+.dny-bolum{position:relative;height:100svh;background:var(--d-bg)}
+.dny-bolum.uc-boyut{height:1500vh}
+.dny-sahne{position:sticky;top:0;height:100svh;max-height:100vh;overflow:hidden;isolation:isolate}
+.dny-sahne canvas{position:absolute;inset:0;width:100%;height:100%;display:block;z-index:-3;opacity:0;transition:opacity 1.6s ease}
+.dny-sahne canvas.hazir{opacity:1}
+.dny-poster{position:absolute;inset:0;z-index:-4;background:#0b0e10 url(/assets/saha/ege-levha.webp) center/cover no-repeat;filter:saturate(.7) brightness(.55)}
+.dny-bolum.dny-akis .dny-poster{transition:opacity 1.6s ease}
+.dny-bolum.hazir .dny-poster{opacity:0}
+/* sinema vinyeti + alt/üst gölge: metin okunur kalsın */
+.dny-sahne::after{content:"";position:absolute;inset:0;z-index:-2;pointer-events:none;
+  background:radial-gradient(120% 85% at 50% 45%,transparent 55%,rgba(3,4,5,.55) 100%),
+    linear-gradient(180deg,rgba(5,7,8,.55) 0,transparent 18%,transparent 62%,rgba(5,7,8,.78) 100%)}
+.dny-kararti{position:absolute;inset:0;z-index:-1;background:#000;opacity:0;pointer-events:none}
+
+/* ---- açılış ---- */
+.dny-acilis{position:absolute;left:var(--d-gut);right:var(--d-gut);bottom:clamp(2rem,9vh,5rem);max-width:40rem;transition:opacity .6s ease,transform .6s ease}
+.dny-acilis .ust{margin:0;font-family:var(--mono);font-size:.75rem;letter-spacing:.2em;text-transform:uppercase;color:var(--d-muted)}
+.dny-acilis h1{margin:.8rem 0 0;font-family:Fraunces,Georgia,serif;font-weight:350;font-variation-settings:"opsz" 144;font-size:clamp(2.4rem,6.5vw,4.75rem);line-height:1;letter-spacing:-.03em;color:var(--d-ink)}
+.dny-acilis p.alt{margin:1rem 0 0;max-width:34rem;font-size:1rem;line-height:1.65;color:var(--d-muted)}
+.dny-kaydir{display:inline-flex;align-items:center;gap:.7rem;margin-top:1.6rem;font-family:var(--mono);font-size:.75rem;letter-spacing:.2em;text-transform:uppercase;color:var(--d-ink)}
+.dny-kaydir i{display:block;width:1px;height:2.4rem;background:linear-gradient(var(--d-cyan),transparent);animation:dnyInis 2.4s ease-in-out infinite}
+@keyframes dnyInis{0%{transform:scaleY(0);transform-origin:top}45%{transform:scaleY(1);transform-origin:top}55%{transform:scaleY(1);transform-origin:bottom}100%{transform:scaleY(0);transform-origin:bottom}}
+.dny-bolum.gecti .dny-acilis{opacity:0;transform:translateY(-1rem);pointer-events:none}
+
+/* ---- üst şerit: bölüm adı ve kot ---- */
+.dny-serit{position:absolute;top:calc(4.4rem + env(safe-area-inset-top));left:var(--d-gut);right:var(--d-gut);display:flex;justify-content:space-between;gap:1rem;
+  font-family:var(--mono);font-size:.6875rem;letter-spacing:.2em;text-transform:uppercase;color:var(--d-muted);opacity:0;transition:opacity .6s ease;pointer-events:none}
+.dny-bolum.gecti .dny-serit{opacity:1}
+.dny-serit b{font-weight:500;color:var(--d-ink)}
+.dny-serit .kot b{font-variant-numeric:tabular-nums}
+.dny-serit .kot .ic{color:var(--d-cyan)}
+
+/* ---- parça etiketi (HUD): yavaşça belirir, yavaşça söner ---- */
+.dny-hud{position:absolute;left:var(--d-gut);bottom:clamp(2rem,10vh,5.5rem);max-width:30rem;pointer-events:none;
+  opacity:0;transform:translateY(.6rem);transition:opacity .7s ease,transform .9s cubic-bezier(.2,.7,.2,1)}
+.dny-hud.gor{opacity:1;transform:none}
+.dny-hud .no{margin:0;display:flex;align-items:center;gap:.8rem;font-family:var(--mono);font-size:.6875rem;letter-spacing:.22em;text-transform:uppercase;color:var(--d-cyan)}
