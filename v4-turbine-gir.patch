+.v-asansor{position:absolute;z-index:2;right:calc(var(--d-gut) + 2.5rem);top:50%;transform:translateY(-50%);width:13.5rem;margin:0;padding:.85rem 1rem .9rem;
+  border-left:1px solid var(--d-cyan);background:linear-gradient(90deg,rgba(7,9,11,.55),rgba(7,9,11,0));opacity:0;transition:opacity .6s ease;pointer-events:none}
+.v-asansor.gor{opacity:1}
+.v-as-ust{margin:0;font-family:var(--mono);font-size:.5625rem;letter-spacing:.24em;text-transform:uppercase;color:var(--d-cyan)}
+.v-as-ad{margin:.3rem 0 0;font-family:var(--sans);font-weight:600;font-size:1.25rem;letter-spacing:-.02em;color:#eef2f5}
+.v-as-yol{margin:.7rem 0 0;display:flex;align-items:center;gap:.55rem;font-family:var(--mono);font-size:.5625rem;letter-spacing:.16em;text-transform:uppercase;color:rgba(238,242,245,.7)}
+.v-as-yol i{position:relative;flex:1;height:1px;background:rgba(238,242,245,.22)}
+.v-as-yol i b{position:absolute;inset:0;transform-origin:left;transform:scaleX(var(--o,0));background:var(--d-cyan)}
+.v-as-kot{margin:.55rem 0 0;font-family:var(--mono);font-size:.6875rem;letter-spacing:.12em;color:rgba(238,242,245,.75)}
+.v-as-kot b{font-size:1rem;font-weight:500;color:#eef2f5;letter-spacing:.02em}
+
+/* ---- temsili yerleşim notu ---- */
+.v-temsil{position:absolute;z-index:2;right:var(--d-gut);bottom:1.1rem;margin:0;font-family:var(--mono);font-size:.5625rem;letter-spacing:.16em;text-transform:uppercase;color:rgba(238,242,245,.5);opacity:0;transition:opacity .6s ease;pointer-events:none}
+.v-temsil.gor{opacity:1}
+
+/* ---- parça bilgi penceresi: kontrol ve sahada belirti ---- */
+.v-nb-dl{margin:.7rem 0 0;display:grid;gap:.55rem}
+.v-nb-dl div{padding-top:.5rem;border-top:1px solid rgba(238,242,245,.12)}
+.v-nb-dl dt{font-family:var(--mono);font-size:.5625rem;letter-spacing:.2em;text-transform:uppercase;color:#f2b233}
+.v-nb-dl dd{margin:.25rem 0 0;font-size:.78rem;line-height:1.5;color:#c9d0d5}
+.dny-bolum.statik .v-erisim,.dny-bolum.statik .v-asansor,.dny-bolum.statik .v-temsil{display:none}
+@media (max-width:820px){
+  .v-asansor{right:auto;left:var(--d-gut);top:auto;bottom:clamp(7.5rem,20vh,10rem);transform:none;width:12rem}
+  .v-temsil{bottom:.6rem;font-size:.5rem}
+}
+@media (prefers-reduced-motion:reduce){ .v-erisim,.v-erisim.gor{transition:opacity .2s linear} }
