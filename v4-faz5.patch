+  var hk={en:'Best move',iyi:'Acceptable, but not the priority',yanlis:'Not right at this stage'}[x.d];
+  var h='<p class="tsh-hukum '+x.d+'">'+hk+'</p><dl><div><dt>Why?</dt><dd>'+esc(x.neden)+'</dd></div>'+
+   (x.soyler?'<div><dt>What does this measurement tell you?</dt><dd>'+esc(x.soyler)+'</dd></div>':'')+
+   (x.bekle?'<div><dt>What would you expect?</dt><dd>'+esc(x.bekle)+'</dd></div>':'')+
+   (x.ek?'<div><dt>On site</dt><dd>'+esc(x.ek)+'</dd></div>':'')+
+   (x.d!=='en'?'<div><dt>Best move at this step</dt><dd>'+esc(en.t)+' '+esc(en.neden)+'</dd></div>':'')+'</dl>'+
