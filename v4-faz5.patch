+   '<button type="button" class="tsh-ileri" id="tshIleri">'+(i+1<s.adimlar.length?'Next step':'See the root cause')+' <span aria-hidden="true">&#8594;</span></button>';
+  var g=document.getElementById('tshGeri'); g.innerHTML=h; g.hidden=false;
