+<style>
+.vdb{--w:min(74rem,calc(100vw - 3rem));width:var(--w);margin:2.75rem 0 0 calc(50% - var(--w)/2)}
+.vdb-ust{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:1.25rem 2rem;padding-bottom:1.25rem;border-bottom:1px solid var(--line)}
+.vdb-kic{margin:0;font-family:var(--mono);font-size:.6875rem;letter-spacing:.2em;text-transform:uppercase;color:var(--beacon)}
+.kb .vdb-bb{margin:.5rem 0 0;font-family:var(--sans);font-size:clamp(1.6rem,3.4vw,2.4rem);line-height:1.05;letter-spacing:-.035em;font-weight:600;border:0;padding:0}
+.vdb-sayi{margin:0;display:flex;gap:1.75rem}
+.vdb-sayi div{border-left:1px solid var(--line);padding-left:.8rem}
+.vdb-sayi dt{font-family:var(--mono);font-size:.625rem;letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}
+.vdb-sayi dd{margin:.2rem 0 0;font-size:1.75rem;font-weight:600;letter-spacing:-.03em;line-height:1;color:var(--ink)}
+.vdb-panel{display:grid;gap:.9rem;margin-top:1.25rem;padding:1.1rem 1.2rem;background:var(--surface);border:1px solid var(--line)}
+.vdb-ara{display:flex;align-items:center;gap:.6rem;padding:0 .9rem;min-height:2.9rem;background:var(--ground);border:1px solid var(--line);color:var(--muted)}
+.vdb-ara:focus-within{border-color:var(--beacon);box-shadow:0 0 0 1px var(--beacon)}
+.vdb-ara input:focus-visible{outline:none}
+.vdb-ara input{flex:1;min-width:0;background:transparent;border:0;outline:0;color:var(--ink);font:inherit;font-size:.9375rem}
+.vdb-grup{display:grid;grid-template-columns:9.5rem minmax(0,1fr);align-items:baseline;gap:.4rem 1rem}
+.vdb-gb{margin:0;font-family:var(--mono);font-size:.625rem;letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}
+.vdb-fler{display:flex;flex-wrap:wrap;gap:.4rem}
+.vdb-f{display:inline-flex;align-items:center;gap:.45rem;min-height:2.25rem;padding:.35rem .75rem;background:transparent;border:1px solid var(--line);color:var(--ink);font:inherit;font-size:.8125rem;cursor:pointer;transition:border-color .15s,background .15s,color .15s}
+.vdb-f:hover{border-color:var(--muted)}
+.vdb-f[aria-pressed="true"]{background:var(--beacon);border-color:var(--beacon);color:var(--on-beacon)}
+.vdb-f:disabled{opacity:.38;cursor:default}
+.vdb-say{font-family:var(--mono);font-size:.6875rem;opacity:.75}
+.vdb-durum{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding-top:.8rem;border-top:1px solid var(--line)}
+.vdb-durum p{margin:0;font-family:var(--mono);font-size:.6875rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
+.vdb-temizle{background:none;border:0;color:var(--beacon);font:inherit;font-size:.8125rem;cursor:pointer;text-decoration:underline;text-underline-offset:3px}
+.vdb-liste{display:grid;gap:1px;margin-top:1.25rem;background:var(--line);border:1px solid var(--line)}
+@media(min-width:56rem){.vdb-liste{grid-template-columns:repeat(2,minmax(0,1fr))}}
+.vdb-kart{position:relative;display:flex;flex-direction:column;gap:1rem;padding:1.4rem 1.4rem 1.2rem;background:var(--surface);transition:background .2s}
+.vdb-kart:hover{background:var(--raise)}
+.vdb-kart[hidden]{display:none}
+.vdb-no{margin:0;max-width:none;display:flex;justify-content:space-between;font-family:var(--mono);font-size:.625rem;letter-spacing:.18em;text-transform:uppercase;color:var(--beacon)}
+.vdb-no span{color:var(--muted)}
+.kb .vdb-ad{margin:.45rem 0 0;font-family:var(--sans);font-size:1.375rem;line-height:1.2;letter-spacing:-.02em;font-weight:600;border:0;padding:0}
+.vdb-ad a{color:var(--ink);text-decoration:none;border:0}
+.vdb-ad a:hover{color:var(--beacon)}
+.vdb-deger{margin:.6rem 0 0;display:flex;align-items:baseline;gap:.7rem;flex-wrap:wrap}
+.vdb-deger b{font-family:var(--mono);font-size:1.0625rem;font-weight:500;color:var(--ink)}
+.vdb-deger small{font-family:var(--mono);font-size:.6875rem;color:var(--muted)}
+.vdb-etiket{margin:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.55rem 1rem;padding:.8rem 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
+.vdb-etiket dt{font-family:var(--mono);font-size:.5625rem;letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}
+.vdb-etiket dd{margin:.15rem 0 0;font-size:.8125rem;color:var(--ink)}
+.vdb-ozet p{margin:0 0 .55rem;font-size:.875rem;line-height:1.6;color:var(--muted)}
+.vdb-ozet b{display:block;margin-bottom:.1rem;font-family:var(--mono);font-size:.625rem;font-weight:400;letter-spacing:.16em;text-transform:uppercase;color:var(--ink)}
+.vdb-yol summary{cursor:pointer;font-size:.8125rem;color:var(--beacon);list-style:none;display:inline-flex;align-items:center;gap:.5rem;min-height:2.25rem}
+.vdb-yol summary::-webkit-details-marker{display:none}
+.vdb-yol summary::before{content:"+";font-family:var(--mono);width:1rem;text-align:center}
+.vdb-yol[open] summary::before{content:"\2212"}
+.vdb-akis{margin:.6rem 0 0;padding:0 0 0 1rem;list-style:none;border-left:1px solid var(--line);display:grid;gap:.8rem}
+.vdb-akis li{position:relative;display:grid;grid-template-columns:7.5rem minmax(0,1fr);gap:.8rem}
+.vdb-akis li::before{content:"";position:absolute;left:calc(-1rem - 4px);top:.35rem;width:7px;height:7px;border-radius:50%;background:var(--ground);border:1px solid var(--beacon)}
+.vdb-akis li:nth-child(3)::before{background:var(--hata);border-color:var(--hata)}
+.vdb-ak-e b{display:block;font-size:.8125rem;font-weight:600;color:var(--ink)}
+.vdb-ak-e small{font-family:var(--mono);font-size:.5625rem;letter-spacing:.14em;color:var(--muted)}
+.vdb-akis p{margin:0;font-size:.8125rem;line-height:1.6;color:var(--muted)}
+.vdb-git{margin-top:auto;align-self:flex-start;font-family:var(--mono);font-size:.6875rem;letter-spacing:.14em;text-transform:uppercase;color:var(--ink);border-bottom:1px solid var(--line);padding-bottom:.2rem;text-decoration:none}
+.vdb-git:hover{color:var(--beacon);border-color:var(--beacon)}
+.vdb-bos{margin-top:1.25rem;padding:2rem 1.4rem;border:1px dashed var(--line);text-align:center}
+.vdb-bos-b{margin:0 0 .4rem;font-size:1.125rem;font-weight:600;color:var(--ink)}
+.vdb-bos p{color:var(--muted)}
+.vdb-not{margin:.9rem 0 0;font-family:var(--mono);font-size:.625rem;letter-spacing:.06em;color:var(--muted)}
+@media(max-width:40rem){
+ .vdb{--w:calc(100vw - 2rem)}
+ .vdb-grup{grid-template-columns:1fr}
+ .vdb-fler{flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none;margin-right:-1.2rem;padding-right:1.2rem}
+ .vdb-fler::-webkit-scrollbar{display:none}
+ .vdb-f{flex:none}
+ .vdb-akis li{grid-template-columns:1fr;gap:.2rem}
+ .vdb-sayi{gap:1rem}
+}
+@media(prefers-reduced-motion:reduce){.vdb-kart,.vdb-f{transition:none}}
+</style>
