+ function ray(){ var ev=['Turbine','Alarm'].concat(s.adimlar.map(function(a){return a.evre;})).concat(['Root cause']);
+  return '<ol class="tsh-ray" aria-label="Progress">'+ev.map(function(e,k){ var c=k<i+2?'gecti':(k===i+2?'simdi':''); if(i>=s.adimlar.length) c=k<ev.length-1?'gecti':'simdi'; return '<li class="'+c+'"'+(c==='simdi'?' aria-current="step"':'')+'>'+esc(e)+'</li>';}).join('')+'</ol>'; }
+ function defterHTML(){ return '<aside class="tsh-defter" aria-label="Field log"><h2>Field log</h2>'+(defter.length?'<ol>'+defter.map(function(d){return '<li><b>'+esc(d.e)+'</b>'+esc(d.b)+'</li>';}).join('')+'</ol>':'<p class="bos">Findings will collect here.</p>')+'</aside>'; }
+ function basla(id){ s=S.filter(function(x){return x.id===id;})[0]; i=0; puan=0; defter=[]; M.hidden=false;
+  kartlar.forEach(function(k){k.setAttribute('aria-pressed',k.getAttribute('data-s')===id?'true':'false');});
+  try{history.replaceState(null,'','#'+id);}catch(e){}
+  adim(); M.scrollIntoView({behavior:az?'auto':'smooth',block:'start'}); }
+ function adim(){
+  if(i>=s.adimlar.length) return bitir();
+  var a=s.adimlar[i], harf='ABCD';
+  var sira=a.secenek.map(function(x,k){return k;}); for(var k=sira.length-1;k>0;k--){var r=Math.floor(Math.random()*(k+1));var t=sira[k];sira[k]=sira[r];sira[r]=t;}
+  M.innerHTML=ray()+'<div class="tsh-sahne"><div class="tsh-baslik"><p><b>'+esc(s.model)+'</b> · '+esc(s.yer)+'</p><p>Step '+(i+1)+' / '+s.adimlar.length+'</p></div>'+
+   (i===0?'<p class="tsh-alarm"><small>Alarm</small>'+esc(s.alarm)+'</p><p class="tsh-durum">'+esc(s.durum)+'</p>':'')+
+   '<h2 class="tsh-soru" tabindex="-1"><span class="tsh-evre">'+esc(a.evre)+'</span>'+esc(a.soru)+'</h2>'+
+   '<ul class="tsh-sec-l">'+sira.map(function(k,n){var x=a.secenek[k];return '<li><button type="button" class="tsh-sec-b" data-k="'+k+'" data-d="'+x.d+'"><span class="h">'+harf[n]+'</span><span>'+esc(x.t)+'</span></button></li>';}).join('')+'</ul>'+
+   '<div class="tsh-geri" id="tshGeri" aria-live="polite" hidden></div></div>'+defterHTML();
+  [].forEach.call(M.querySelectorAll('.tsh-sec-b'),function(b){ b.addEventListener('click',function(){ sec(+b.getAttribute('data-k')); }); });
+  if(i>0) M.querySelector('.tsh-soru').focus({preventScroll:true});
+ }
